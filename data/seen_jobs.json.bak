    "linkedinpost:a5f6430aa7468edfaa3529c9": {
      "job": {
        "title": "📢 FULL STACK DEVELOPER (REACT.JS, NEXT.JS, NESTJS, PHP)",
        "company": "",
        "location": "Karachi, Pakistan",
        "url": "https://www.linkedin.com/posts/waseelaerozgar-jobopportunity-hiring-share-7528820692117712896-N5tR",
        "platform": "LinkedIn Post",
        "date_posted": "2026-11-18T14:05:31.983000+00:00",
        "is_remote": null,
        "description": "How to Apply:\n📩 Email CV: careers@imtiaz.com.pk\n💬 WhatsApp CV: 0326-3339777 (ya flyer par maujood QR code scan karein)\n⚠️ Email Subject Line: \"Full Stack Developer - Karachi\" likhna zaroori hai\n📅 Last Date to Apply: 22nd Nov, 2026\n\nSource: Imtiaz Group Official Hiring Announcement\n\nNote: Apply only through the official contact/application details provided above. No fee is charged by Waseela-e-Rozgar for sharing job opportunities.\n\nFollow Waseela-e-Rozgar for employment opportunities, career guidance, skills, community support and initiatives that help connect people with opportunities and support a more financially independent future.\n\n#WaseelaERozgar\n#JobOpportunity\n#Hiring\n#FullStackDeveloper\n#ReactJS\n#NextJS\n#NestJS\n#SoftwareEngineer\n#ImtiazGroup\n#KarachiJobs\n#JobsPakistan\n📢 FULL STACK DEVELOPER (REACT.JS, NEXT.JS, NESTJS, PHP)\n\nCompany: Imtiaz Group (Private) Limited\nLocation: Karachi",
        "job_id": "linkedinpost:a5f6430aa7468edfaa3529c9",
        "recruiter_email": "careers@imtiaz.com.pk",
        "is_priority_location": false,
        "source_id": "role:c35ab70435ed56984e12",
        "application_url": "",
