    "linkedin:935cdea0fa15dbe7492c5ee3": {
      "job": {
        "title": "Full Stack Engineer",
        "company": "AIZ Business Consulta",
        "location": "",
        "url": "https://www.linkedin.com/jobs/view/4476722277",
