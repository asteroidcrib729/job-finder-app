    "indeed:63e4184656ab67e465460363": {
      "job": {
        "title": "WE ARE HIRING AI WEB DEVELOPER",
        "company": "",
        "location": "Karachi Gulshan-E-Iqbal, PSD, PK",
        "url": "https://pk.indeed.com/viewjob?jk=8d17008f45467753",
